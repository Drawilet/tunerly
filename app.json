{
  "expo": {
    "name": "tunerly",
    "slug": "tunerly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tunerly",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#010100",
      "imageWidth": 449
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.drawilet.tunerly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#010100",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drawilet.tunerly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010100",
          "image": "./assets/images/splash.png",
          "imageWidth": 449
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e93765c6-9a2d-4aea-b810-ba483385df8c"
      }
    },
    "owner": "drawilets-team"
  }
}
